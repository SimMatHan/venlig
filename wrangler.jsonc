{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "venlig",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "venlig",
			// Fra `npx wrangler d1 create venlig`. Ikke en hemmelighed.
			"database_id": "6ec2e42f-48f7-48f4-a13d-11f9a79769da",
			"migrations_dir": "migrations"
		},
		{
			"binding": "venlig",
			"database_name": "venlig",
			"database_id": "6ec2e42f-48f7-48f4-a13d-11f9a79769da",
			"remote": true
		}
	],
	// Sender daglige påmindelser. Tjekker hvert 5. minut, hvem der skal have en.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}