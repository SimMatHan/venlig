{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "venlig",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// nodejs_compat: MCP-SDK'et. global_fetch_strictly_public: kræves når OAuth henter klienters metadata (CIMD).
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*"]
	},
	// Tokens og klienter til MCP-forbindelsens OAuth-login.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "749602362f7c4a848f220359f6d97d06" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "venlig",
			// Fra `npx wrangler d1 create venlig`. Ikke en hemmelighed.
			"database_id": "6ec2e42f-48f7-48f4-a13d-11f9a79769da",
			"migrations_dir": "migrations"
		}
	],
	// Sender daglige påmindelser. Tjekker hvert 5. minut, hvem der skal have en.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}